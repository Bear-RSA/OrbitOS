rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function userOrg() {
      return hasUserDoc() ? userData().orgId : null;
    }

    function userRole() {
      return hasUserDoc() ? userData().role : null;
    }

    function isInOrg(orgId) {
      return hasUserDoc() && userOrg() == orgId;
    }

    function isOwner(orgId) {
      return isInOrg(orgId) &&
        (userRole() == 'OWNER' || userRole() == 'owner');
    }

    function isMember(orgId) {
      return isInOrg(orgId) &&
        (
          userRole() == 'OWNER' ||
          userRole() == 'owner' ||
          userRole() == 'MEMBER' ||
          userRole() == 'member'
        );
    }

    /* Fields whose values differ between the incoming write and the
       stored document. Unchanged fields are not reported, so a write
       that re-sends an identical value is always permitted. */
    function editedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /tasks/{taskId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId);
      allow update: if isMember(resource.data.orgId);
      allow delete: if isMember(resource.data.orgId);
    }

    /* Engagements — scheduled time with people in it.

       Writes all run through server actions on the Admin SDK, which
       bypasses these rules; what matters here is that the client's
       live subscription can read its own org and nothing else.
       Deletion is withheld from Members on purpose: cancelling sets
       status to 'cancelled' and keeps the record, so a Member has no
       reason to remove the document outright. */
    match /events/{eventId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId);

      /* The guest half of an engagement is server-owned. Every path that
         touches it — resolving an address to a guest record, recording a
         reply from a signed link, bumping SEQUENCE — runs through the
         Admin SDK in `actions/events` and `actions/rsvp`, so nothing
         legitimate writes these from a browser.

         Leaving them open would let any Member forge an outsider's RSVP,
         rename a guest, or freeze SEQUENCE so that a reschedule never
         reaches anyone's calendar. */
      /* The call fields are server-owned for the same reason, and one of
         them is worse than the rest: `roomId` is the capability that
         gets a person into the room. A Member able to write it could
         point an engagement at a room they control and have the other
         attendees walk into it. `callActive` is the gate the walk-in
         path checks, so forging it would re-open a forwarded link. */
      allow update: if isMember(resource.data.orgId)
        && !editedKeys().hasAny([
          'guests', 'guestRsvp', 'guestNames', 'sequence',
          'callProvider', 'roomId', 'callActive', 'callStartedAt'
        ]);

      allow delete: if isOwner(resource.data.orgId);
    }

    /* Direct calls — one operative ringing another.

       Readable by the two people on it and nobody else. Org membership
       is deliberately not enough: a call is between two named people,
       and a third member of the same workspace has no more business
       reading it than a stranger does. The one exception is the org-wide
       read used to show "on a call" in the Personnel Network, which is
       why an ACTIVE call is visible to the workspace — that a colleague
       is busy is exactly what that view exists to say, and the document
       carries no content beyond who and when.

       Writes are server-only. `roomId` is a capability and `status` is
       what the answer gate reads, so a client that could write either
       could join a call it was never part of, or revive a ring that had
       already timed out. */
    match /calls/{callId} {
      allow read: if isSignedIn()
        && isInOrg(resource.data.orgId)
        && (
          request.auth.uid == resource.data.from ||
          request.auth.uid == resource.data.to ||
          resource.data.status == 'active'
        );

      allow write: if false;
    }


    /* Conversations — direct messages, groups, and the org's Town Hall.

       Three shapes in one collection, told apart by `type`. The read
       rule is the entire membership model for Town Hall: it carries no
       participant list, because its membership is "everyone currently
       in the org" and that changes on every invite accepted and every
       person removed. Deriving it from the live `users/{uid}` doc — the
       same way `tasks` and `events` derive theirs — means there is no
       array to keep in sync, and no Cloud Function needed to do it.

       Creation is server-only. A conversation names the people in it,
       and a client able to write `participantIds` could add itself to a
       thread it was never part of, or open one in somebody else's name.
       `actions/messages` resolves the caller from the session cookie and
       checks the org of every uid it is handed.

       Sending, by contrast, IS a direct client write — see the
       subcollection below. A message is ordinary org-scoped data like a
       task, not a capability like a room id, so it is gated here rather
       than round-tripped through a server action. */
    match /conversations/{conversationId} {

      /* Written as a disjunction rather than a ternary on `type`, and
         that is load-bearing rather than a matter of taste.

         A LIST — the rail's `orgId + array-contains uid + orderBy`
         query — is authorized against the QUERY, not against the rows
         it would return. Firestore has to prove the rule holds for
         every document the query could possibly match, using only the
         query's own constraints. Nothing in that query constrains
         `type`, so a ternary branching on `type` is unresolvable and
         the entire listen is refused.

         In this form the `array-contains` filter proves the second
         operand outright, so the OR is true whatever `type` turns out
         to be, and the query is provable. A single-document GET was
         never affected — `resource.data` is concrete there — which is
         exactly why Town Hall kept working while every dm and group
         silently vanished from the rail and the notification panel.

         The permission granted is unchanged: townhall => any member of
         the org; anything else => a participant, in the org. */
      function mayRead() {
        return isInOrg(resource.data.orgId)
          && (resource.data.type == 'townhall' ||
              request.auth.uid in resource.data.participantIds);
      }

      /* The same split `lib/messages/access` makes: in Town Hall,
         posting is narrower than reading. Everyone gets the notices;
         only the OWNER writes them. */
      function mayPost() {
        return resource.data.type == 'townhall'
          ? isOwner(resource.data.orgId)
          : (isInOrg(resource.data.orgId) &&
             request.auth.uid in resource.data.participantIds);
      }

      /* `lastReadAt` is one map shared by everyone in the thread, so
         "only these fields" is not enough on its own — without this, a
         participant could mark a colleague's unread thread as read, or
         wipe the entry of someone who had already read it. */
      function touchesOnlyOwnReadReceipt() {
        return !editedKeys().hasAny(['lastReadAt']) ||
          request.resource.data.lastReadAt
            .diff(resource.data.lastReadAt)
            .affectedKeys()
            .hasOnly([request.auth.uid]);
      }

      /* Clearing is per-person, and this is what keeps it that way: a
         member may set their OWN entry and nobody else's. Without it,
         "clear my chat" would be one dotted write away from clearing
         the thread out of a colleague's rail too — and on a dm, from
         hiding a conversation from the only other person in it.

         The stored map is absent on conversations created before this
         existed, and `diff` cannot read a field that is not there — so
         a first clear is checked by looking at the incoming map
         instead, which a dotted write leaves holding exactly one key. */
      function touchesOnlyOwnClearedAt() {
        return !editedKeys().hasAny(['clearedAt']) ||
          (
            'clearedAt' in resource.data
              ? request.resource.data.clearedAt
                  .diff(resource.data.clearedAt)
                  .affectedKeys()
                  .hasOnly([request.auth.uid])
              : request.resource.data.clearedAt.keys().hasOnly([request.auth.uid])
          );
      }

      allow read: if isSignedIn() && mayRead();

      // Creation is server-only (Admin SDK) — see the block comment above.
      allow create: if false;

      /* Cancelled engagements keep their record and so do conversations:
         a thread is the account of what was said, and a hole in it is
         worse than a message marked withdrawn. */
      allow delete: if false;

      /* A participant may only touch the fields their own use of the
         thread is responsible for: their own `lastReadAt` entry, and the
         denormalized "what happened last" trio that every send has to
         keep current. Nothing here can add or remove a participant,
         rename the conversation, or change its type — that stays
         server-owned the same way `roomId` and `callActive` do on an
         engagement.

         Marking a thread read is something any reader may do; writing
         the trio is not, because it is the left rail's account of who
         said the last thing. So the trio needs post rights, which in
         Town Hall means the OWNER — otherwise a Member who cannot post
         a notice could still forge the preview of one. */
      allow update: if isSignedIn()
        && editedKeys().hasOnly([
             'lastMessageAt', 'lastMessagePreview', 'lastMessageBy',
             'lastReadAt', 'clearedAt'
           ])
        && touchesOnlyOwnReadReceipt()
        && touchesOnlyOwnClearedAt()
        && (!editedKeys().hasAny(['lastMessageBy']) ||
            request.resource.data.lastMessageBy == request.auth.uid)
        /* Marking a thread read, or clearing it from your own rail, are
           things any reader may do to their own view. Writing the trio
           is not — it is the rail's account of who said the last thing,
           and in Town Hall a Member who cannot post a notice must not
           be able to forge the preview of one. */
        && (editedKeys().hasOnly(['lastReadAt', 'clearedAt']) ? mayRead() : mayPost());

      match /messages/{messageId} {

        /* One parent lookup per evaluation, the same pattern
           `projects/{projectId}/files/{fileId}` already uses. Repeated
           calls within a single evaluation are served from cache, so the
           read and write rules below share one get(). */
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if isSignedIn() && (
          conversation().type == 'townhall'
            ? isInOrg(conversation().orgId)
            : (isInOrg(conversation().orgId) &&
               request.auth.uid in conversation().participantIds)
        );

        /* The client writes this one directly, so this rule is the only
           thing standing between a text field and the collection: it
           pins the author to the session, the timestamp to the server,
           and the length to MAX_MESSAGE_LENGTH in
           `lib/validations/messages`. `senderName` is deliberately not a
           field — see the note in `types/message` — so there is nothing
           here for a sender to forge a display name into. */
        /* A GIF or sticker rides along as a reference, never as bytes.

           The URL check is the load-bearing part, and it is a security
           control rather than tidiness. An attachment becomes an
           <img src> in every participant's browser, so a member able to
           write an arbitrary URL there has a tracking pixel: point it at
           a host they control and every colleague who scrolls past the
           message reports their IP, their user agent and the moment they
           read it. The image does not even have to exist.

           So the host is pinned to the provider's own CDN, anchored at
           both ends — an unanchored pattern would accept
           `https://evil.test/media.giphy.com/x.gif`, which is the usual
           way an allowlist turns out to allow everything. Mirrored in
           `lib/messages/attachment` so the client refuses first and the
           sender sees an error instead of a rejected write. */
        function attachedMedia() {
          return request.resource.data.attachment;
        }

        function hasAttachment() {
          return 'attachment' in request.resource.data
            && attachedMedia() != null;
        }

        function providerUrl(value) {
          return value is string
            && value.matches('^https://(media[0-9]*|i)[.]giphy[.]com/[A-Za-z0-9._~/-]+([?][A-Za-z0-9._~/&=%-]*)?$');
        }

        function attachmentIsSound() {
          return attachedMedia().keys().hasAll([
               'kind', 'url', 'previewUrl', 'width', 'height',
               'alt', 'provider', 'providerId'
             ])
            && attachedMedia().keys().hasOnly([
               'kind', 'url', 'previewUrl', 'width', 'height',
               'alt', 'provider', 'providerId'
             ])
            && (attachedMedia().kind == 'gif' || attachedMedia().kind == 'sticker')
            && attachedMedia().provider == 'giphy'
            && providerUrl(attachedMedia().url)
            && providerUrl(attachedMedia().previewUrl)
            && attachedMedia().providerId is string
            && attachedMedia().providerId.size() > 0
            && attachedMedia().providerId.size() <= 64
            && attachedMedia().alt is string
            && attachedMedia().alt.size() <= 200
            && attachedMedia().width is int
            && attachedMedia().width >= 1 && attachedMedia().width <= 4000
            && attachedMedia().height is int
            && attachedMedia().height >= 1 && attachedMedia().height <= 4000;
        }

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
               'senderId', 'createdAt', 'text', 'editedAt', 'deletedAt', 'attachment'
             ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          /* Words, or a picture, or both — never neither. */
          && (request.resource.data.text.size() > 0 || hasAttachment())
          && (!hasAttachment() || attachmentIsSound())
          && (
            conversation().type == 'townhall'
              ? isOwner(conversation().orgId)
              : (isInOrg(conversation().orgId) &&
                 request.auth.uid in conversation().participantIds)
          );

        /* Editing and soft-deleting your own message only. Deletion is
           withheld outright: `deletedAt` keeps the row and the thread's
           shape, and removing the document would leave replies answering
           nothing. */
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && editedKeys().hasOnly(['text', 'editedAt', 'deletedAt'])
          && (!editedKeys().hasAny(['text']) || (
               request.resource.data.text is string &&
               request.resource.data.text.size() > 0 &&
               request.resource.data.text.size() <= 4000
             ));

        allow delete: if false;
      }
    }

    /* Guests are server-only, and the read side is the point: a workspace's
       guest list is its client list. Any Member could otherwise enumerate
       every outside party the studio has ever met with, along with their
       email addresses. Organizers reach the guests on their OWN engagement
       through `getEngagementGuestsAction`, which checks org membership and
       returns only that engagement's participants. */
    match /guests/{guestId} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if isMember(resource.data.orgId);
      allow create: if isMember(request.resource.data.orgId);
      allow update: if isOwner(resource.data.orgId);
      allow delete: if isOwner(resource.data.orgId);

      match /files/{fileId} {
        allow read: if isMember(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId);
      }
    }

    match /users/{userId} {

      /* Treat a missing orgId the same as an unassigned one. */
      function currentOrgId() {
        return 'orgId' in resource.data ? resource.data.orgId : '';
      }

      /* Ordinary profile maintenance. `role` and `orgId` are deliberately
         excluded: privilege and org membership are assigned only by
         server actions running on the Admin SDK, which bypasses rules. */
      function isProfileEdit() {
        return editedKeys().hasOnly([
          'name',
          'roleDescriptor',
          'bio',
          'photoURL',
          'photoPublicId',
          'lastActivity',
          'operationalStatus',
          'manualOverride',
          'preferences'
        ]);
      }

      /* Workspace genesis — the one legitimate client-side org binding.
         A user who belongs to no organization may attach themselves to an
         organization they just created. The org's `ownerId` must be their
         own uid, so this cannot be used to join someone else's workspace,
         and requiring an empty starting orgId means it happens only once. */
      function isWorkspaceGenesis() {
        return currentOrgId() == ''
          && request.resource.data.orgId is string
          && request.resource.data.orgId != ''
          && request.resource.data.role == 'OWNER'
          && get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid
          && editedKeys().hasOnly(['name', 'email', 'orgId', 'role', 'createdAt']);
      }

      /* Own profile, or a teammate in the same organization. */
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isInOrg(resource.data.orgId));

      /* Self-provisioning at sign-up. Requiring an empty orgId makes the
         client-supplied `role` inert: every org-scoped rule and every
         server-side check requires a matching orgId to grant anything. */
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.orgId == '';

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && (isProfileEdit() || isWorkspaceGenesis());
    }

    match /organizations/{orgId} {
      allow read: if isInOrg(orgId);

      /* You may only create an organization you own. `isWorkspaceGenesis`
         above depends on this to keep org binding self-referential. */
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      /* Billing state is authoritative and server-owned. Letting an OWNER
         write `subscription` from the client would let them grant
         themselves any tier for free; PayFast's webhook and the billing
         server actions use the Admin SDK and are unaffected by this. */
      allow update: if isOwner(orgId)
        && !editedKeys().hasAny(['subscription', 'ownerId']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
