# OrbitOS — Production Environment Configuration

# Next.js
NEXT_PUBLIC_APP_URL=https://orbit-os.co.za

# Firebase (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase (Server-side / Admin SDK)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (Email Operations)
# One key covers every outbound mail. All senders use the already-verified
# mail.orbit-os.co.za subdomain, varying only the local part by purpose
# (reminders@, debrief@, engagements@) — Resend accepts any local part on a
# verified domain, so a new mail needs no new DNS. Adding a mail from a
# DIFFERENT domain would need its own SPF/DKIM verification in Resend,
# independent of whatever Zoho already serves for orbit-os.co.za.
RESEND_API_KEY=re_your_api_key

# Cron (Scheduled Jobs)
# Vercel sends this as "Authorization: Bearer $CRON_SECRET" on every
# scheduled invocation. Every scheduled route checks it and 401s without
# it, so an unset value disables them rather than leaving them open.
#
# Vercel Cron schedules are UTC and take no timezone parameter, so the SAST
# times these are designed around are baked into the cron expressions.
# SAST is UTC+2 year round with no DST, which is what makes that safe.
#
# This account is on Vercel's Hobby plan, which allows TWO cron jobs, so the
# four scheduled mails are grouped by time of day rather than given a slot
# each:
#
#   /api/cron/morning   04:00 UTC / 06:00 SAST — runs three jobs in order:
#       1. due-today     everything due TODAY, one mail per assignee
#       2. owner-digest  owner-only workspace health (overdue, stalled, risk)
#       3. due-tomorrow  everything due TOMORROW, one mail per assignee
#                        (unassigned work goes to the owner)
#   /api/debrief        16:00 UTC / 18:00 SAST
#       per-person summary of the day, skipped for anyone with no activity
#
# Each morning job is isolated — one throwing does not cost the other two
# their run — and each is still individually triggerable for manual runs and
# retries at /api/reminders/due-today, /api/digest and /api/reminders/tasks.
#
# On Pro the three could go back to separate slots at 06:00, 07:00 and 09:00
# SAST by restoring four entries in vercel.json pointing at those routes.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=your_32_char_minimum_random_secret

# Calendar Feed + RSVP links (ICS subscriptions and guest invitations)
# Signs TWO things, both of which are credentials carried in a URL because
# the client holding them cannot sign in:
#   1. the per-user feed URL at /api/calendar/{token}.ics
#   2. the per-guest RSVP link at /rsvp/{token} sent with engagement invites
# Must be 32+ random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every calendar subscription AND every RSVP link
# already sitting in an invitee's inbox — including guests outside the
# workspace, who have no other way to answer. Rotate deliberately.
CALENDAR_FEED_SECRET=your_32_char_minimum_random_secret

# Sentry (Error Monitoring - Recommended)
# SENTRY_AUTH_TOKEN=your_auth_token
# NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# Tier Enforcement
# Off during build-out: tiers exist and are priced, but no quota is gated yet.
# Set to "true" only after backfilling organizations/{id}.subscription — orgs
# without that field default to the free tier and will be locked out.
BILLING_GUARDRAILS_ENABLED=false

# Payfast (Billing — Subscription Processing)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your_merchant_id
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=your_merchant_key
NEXT_PUBLIC_PAYFAST_SANDBOX=true
